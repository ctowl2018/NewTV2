<resources>

    <style name="Control.Script" parent="Control" />

    <!--
      海报圆角口径（JetStream 风格）：网格海报 / 删除遮罩 16dp 四角全圆，
      列表缩略图 14dp，圆形海报 50%。片名已移到海报下方独立成行，
      不再需要「图片只圆上方两角 + 片名条补下方两角」的拼接做法。
    -->
    <style name="Vod">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="Vod.Grid">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Vod.Grid.Large">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Vod.Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Vod.List">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Player">
        <item name="resize_mode">fit</item>
        <item name="use_artwork">true</item>
        <item name="use_controller">false</item>
    </style>

    <style name="Player.Vod">
        <item name="keep_content_on_player_reset">false</item>
    </style>


</resources>
