<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：橙色斜切播放三角（来源 main_icon.svg）。
  坐标按 1024 viewport ÷ 2 换算到 512，并整体缩放 0.8 + 平移 51.2，
  让图形落在 adaptive icon 的中心安全区（66dp / 108dp）内，避免被圆形遮罩切角。
  渐变端点与 path 在同一局部坐标系，随 group 一起变换，不会错位。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="51.2"
        android:translateY="51.2">
        <group>
            <!-- 圆角三角轮廓：亮面 / 暗面 / 高光都收在这条边界内 -->
            <clip-path android:pathData="M159.81,125.14 Q149.5,119 149.5,131 L149.5,381 Q149.5,393 159.81,386.86 L369.19,262.14 Q379.5,256 369.19,249.86 Z" />

            <!-- 亮面：#FFF0CE → #FFB45E -->
            <path android:pathData="M149.5,119 L149.5,139 L308.685,298.185 L379.5,256 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:endX="379.5"
                        android:endY="393"
                        android:startX="149.5"
                        android:startY="119"
                        android:type="linear">
                        <item android:color="#FFFFF0CE" android:offset="0" />
                        <item android:color="#FFFFB45E" android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- 暗面：#FF8F3C → #D9590F -->
            <path android:pathData="M149.5,139 L149.5,393 L308.685,298.185 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:endX="379.5"
                        android:endY="393"
                        android:startX="149.5"
                        android:startY="119"
                        android:type="linear">
                        <item android:color="#FFFF8F3C" android:offset="0" />
                        <item android:color="#FFD9590F" android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- 左上高光：白色 22% → 6% → 0，铺满三角由裁剪收边 -->
            <path android:pathData="M149.5,119 L379.5,119 L379.5,393 L149.5,393 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:endX="224.5"
                        android:endY="319"
                        android:startX="149.5"
                        android:startY="119"
                        android:type="linear">
                        <item android:color="#38FFFFFF" android:offset="0" />
                        <item android:color="#0FFFFFFF" android:offset="0.45" />
                        <item android:color="#00FFFFFF" android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
</vector>
