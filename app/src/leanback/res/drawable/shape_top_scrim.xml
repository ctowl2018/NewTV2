<?xml version="1.0" encoding="utf-8"?>
<!--
  顶部渐变遮罩：屏幕边缘最深（黑 50%），向下线性渐变到全透明。
  高度由代码按「顶栏底边 + 5dp」动态设置（HomeActivity.applyTopScrim /
  VodActivity.applyTopScrim），因此这里不写死尺寸。
  angle=270 表示从上到下；startColor 对应顶部边缘。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:endColor="#00000000"
        android:startColor="#80000000" />

</shape>
