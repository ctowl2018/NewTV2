<?xml version="1.0" encoding="utf-8"?>
<!--
  播放控制条背景：整体自下而上由纯黑渐隐到全透明，顶部边缘平直（无圆角）。

  两层叠加：
    1) 线性渐变：底边 #FF000000 → 顶边 #00000000，保证文字与图标在任何画面上都有对比度；
    2) 底部 20px 实心纯黑：让最贴近屏幕下沿的一段保持 100% 不透明，
       避免渐变一上来就开始变淡、底部显得发灰（20px 是屏幕像素，不随 dp 缩放）。

  angle=90 表示渐变方向由「底」指向「顶」：startColor 落在底边，endColor 落在顶边。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#FF000000"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:gravity="bottom"
        android:height="20px">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>

</layer-list>
