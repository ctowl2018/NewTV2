<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形海报聚焦前景：与矩形海报共用 120ms 淡入淡出的纯白描边口径。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">

    <item android:drawable="@drawable/shape_vod_oval_focused" android:state_focused="true" />
    <item android:drawable="@drawable/shape_vod_oval_focused" android:state_pressed="true" />
    <item android:drawable="@drawable/shape_vod_oval_focused" android:state_selected="true" />
    <item android:drawable="@drawable/shape_vod_oval_unfocused" />

</selector>
