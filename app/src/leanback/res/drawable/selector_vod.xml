<?xml version="1.0" encoding="utf-8"?>
<!--
  海报图片容器的聚焦前景：focused / pressed / selected 都出纯白描边，
  默认项是全透明同圆角底；120ms 进出淡入淡出与卡片的 120ms 缩放同步。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">

    <item android:drawable="@drawable/shape_vod_focused" android:state_focused="true" />
    <item android:drawable="@drawable/shape_vod_focused" android:state_pressed="true" />
    <item android:drawable="@drawable/shape_vod_focused" android:state_selected="true" />
    <item android:drawable="@drawable/shape_vod_unfocused" />

</selector>
