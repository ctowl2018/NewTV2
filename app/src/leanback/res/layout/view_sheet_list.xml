<?xml version="1.0" encoding="utf-8"?>
<!--
  浮层里的单列列表（选集 / 倍速共用）。

  布局分两段：顶部标题行 + 下方列表容器。
  标题行与「播放设置」浮层用的是同一套样式（PlaybackSheetTitleRow / PlaybackSheetTitle），
  所以「选集」「倍速」「更多设置」三个弹窗的标题字号、颜色、左右缩进完全一致。
  标题由 SheetList.setTitle() 回写，没有标题时整行 GONE，不占高度。

  列表与「弹幕搜索列表」同一套实现：普通 RecyclerView + LinearLayoutManager，
  用 maxHeight 限制可视高度（由 SheetList.setRows 回写），超出一屏时按框架默认行为滚动
  —— 焦点走到边缘后列表继续滚，到头即停、无回弹。不再使用 leanback 的窗口对齐。

  「选中框」不再画在每一行上（行会被 RecyclerView 回收，addStatesFromChildren 在滚动/复用后
  容易留下过期的焦点态，表现为框停在初始位置不动）。改为在列表容器上放唯一一个 overlay：
  SheetList 在焦点变化与滚动时把它移动到当前聚焦行的位置，并钳制在容器边界内，
  因此框始终跟随滚动、不会溢出列表容器。

  注意：选中框的钳制基准是 sheetListFrame（只含列表这一段），不是整块含标题的根视图——
  否则标题的高度会被算进容器，框会整体下坠。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetListRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/sheetListTitleRow"
        style="@style/PlaybackSheetTitleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sheetListTitle"
            style="@style/PlaybackSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <FrameLayout
        android:id="@+id/sheetListFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true"
        android:clipToPadding="true">

        <com.fongmi.android.tv.ui.custom.CustomRecyclerView
            android:id="@+id/sheetList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- 唯一的选中框：位置由 SheetList.syncSelectionFrame() 计算，始终钳制在列表容器内 -->
        <View
            android:id="@+id/sheetSelection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_sheet_focus"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
