<?xml version="1.0" encoding="utf-8"?>
<!--
  首页分四层（FrameLayout 的子 View 顺序即绘制顺序，后画的压在先画的之上；
  再用 elevation 显式拉开 Z 序，避免 recycler 内部聚焦 item / 系统焦点高亮抢到上层）：

    L0  ProgressLayout → VerticalGridView
        主视觉 + 全部内容行。
    L1  topScrim（无 elevation，靠绘制顺序压在 recycler 之上、工具栏之下）
        顶部渐变遮罩：屏幕边缘黑 50%，向下淡出到全透明。高度由
        HomeActivity.applyTopScrim() 按「工具栏底边 + 5dp」动态设置，不遮住顶栏文字。
    L2  homeToolbar（elevation 8dp）
        屏幕顶部一条 64dp 单行工具栏（导航 16sp 加粗、垂直居中对齐、无文字投影）：
        最左是搜索圆钮（36dp 深色圆 + 白色放大镜，点击进搜索页）；
        其次 6 个导航文字按钮（首页 / 电影 / 剧集 / 综艺 / 片库 / 我的——「我的」是设置入口）；
        右侧依次是 站源下拉入口 → 时钟。
    L3  siteSheet（elevation 16dp，最后一个子 View）
        FocusTrapFrameLayout：显示期间把方向焦点搜索截断在容器内部；内容为站源列表。
        原品牌入口的功能 sheet（moreSheet）已随 logo 弹窗菜单一并移除。
    L4  splashBrand（elevation 32dp）
        启动画面 banner：静态显示 640×360（原始 1280×720 的 50%）等比居中，
        约 600ms 后自动淡出隐藏。

  层级保证：sheet > toolbar > topScrim > recycler。浮层控件全部叠加在主视觉之上，
  不占用列表行。toolbar/sheet 是 ProgressLayout 的兄弟节点，因此
  ProgressLayout.showProgress() 隐藏 recycler 时不会把它们一起隐藏。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- L0：列表内容（主视觉是它的第 0 行） -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            android:paddingBottom="24dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- L1：顶部渐变遮罩（高度由代码设置；不参与焦点与点击） -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_gravity="top"
        android:background="@drawable/shape_top_scrim"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- L2：顶部工具栏（可复用布局 view_home_toolbar.xml，与分类页共用同一份样式） -->
    <include
        android:id="@+id/homeToolbar"
        layout="@layout/view_home_toolbar" />

    <!-- L3-a：站源下拉面板（可复用布局 view_site_sheet.xml，与首页 / 分类页共用） -->
    <include
        android:id="@+id/siteSheet"
        layout="@layout/view_site_sheet" />

    <!-- L4：启动画面 banner（静态显示，1280×720 的 50% = 640×360 等比居中），
         约 600ms 后自动淡出隐藏；不参与焦点与点击，elevation 最高。 -->
    <com.fongmi.android.tv.ui.custom.SplashBrandView
        android:id="@+id/splashBrand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="32dp"
        android:focusable="false"
        android:importantForAccessibility="no" />

</FrameLayout>
