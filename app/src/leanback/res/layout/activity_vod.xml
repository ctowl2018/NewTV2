<?xml version="1.0" encoding="utf-8"?>
<!--
  片库 / 分类页：顶部工具栏（与首页同一份布局）+ 分类导航（横向胶囊）+ 分页内容。

  布局结构（自下而上）：
    L0  topScrim   顶部渐变遮罩，垫在最底层：高度 = 工具栏底边 + 5dp（代码设置）。
    L1  LinearLayout（垂直流式，match_parent）
        ① <include view_home_toolbar>  —— 整条顶栏（搜索圆钮 + 6 导航（含「我的」设置入口）+ 站源 + 时钟，
           单行 64dp），样式 / 间距 / 焦点反馈与首页完全一致，只维护
           view_home_toolbar.xml 一份；
        ② <HorizontalGridView recycler> —— 分类胶囊（原第 0 项，现排顶栏下方，二者不重叠）；
        ③ <CustomViewPager pager>       —— 高度 0dp + weight=1，精确占据剩余空间，
           不与顶栏、分类导航重叠，也不会因内容高度溢出而错位。
    L2  siteSheet  站源下拉面板（view_site_sheet，与首页共用），铺满全屏、elevation 最高。

  ⚠️ 顶栏是**流式布局的普通子项**（不是浮层）：不会盖住分类导航，滚动内容也不会穿到它下面。
  因此本页不做首页那套「随焦点自动收/放顶栏」的动画 —— 收起会造成整页位移。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- L0：顶部渐变遮罩（高度由 VodActivity.applyTopScrim() 设置；不参与焦点与点击） -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_gravity="top"
        android:background="@drawable/shape_top_scrim"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- L1：顶栏 → 分类导航 → 内容，垂直排列 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部工具栏：与首页共享 view_home_toolbar.xml（marginTop 16dp 由该布局根节点自带） -->
        <include
            android:id="@+id/homeToolbar"
            layout="@layout/view_home_toolbar" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            app:focusOutEnd="false"
            app:focusOutFront="false" />

        <!-- 0dp + weight=1：吃掉顶栏与分类导航之外的全部高度，杜绝重叠 / 溢出 -->
        <com.fongmi.android.tv.ui.custom.CustomViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- L2：站源下拉面板（与首页共享 view_site_sheet.xml） -->
    <include
        android:id="@+id/siteSheet"
        layout="@layout/view_site_sheet" />

</FrameLayout>
