<?xml version="1.0" encoding="utf-8"?>
<!--
  收藏页 / 最近观看海报卡片（KeepAdapter / HistoryPresenter）。

  与 adapter_vod_rect.xml 同构，两处差异：
    ① poster 内多一层 delete 删除态遮罩（16dp 圆角，不会露出直角黑块）；
    ② metadata 常显而非聚焦展开 —— 收藏 / 历史需要常驻的来源与进度信息。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:clipChildren="false"
        android:duplicateParentState="true"
        android:foreground="@drawable/selector_vod">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_20"
            app:shapeAppearanceOverlay="@style/Vod.Grid" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/delete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_vod_delete"
            android:scaleType="center"
            android:src="@drawable/ic_vod_delete"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="8dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/selector_vod_title"
        android:textSize="16sp"
        tools:text="蜘蛛人" />

    <!--
      元数据行：年份 / 备注 / 站源。
      <b>基线对齐（勿改成 center_vertical）</b>：横排 LinearLayout 只有在子项
      「非 match_parent 高度 + 垂直 gravity 为 TOP」时才对齐基线（CENTER_VERTICAL
      分支的基线对齐已被官方移除，见 bug #1038483）。否则数字与中文按各自字体
      度量独立居中，会差几个像素、看起来不齐。
    -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/metadata"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:gravity="start|top"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/white_60"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="2022"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/white_60"
            android:textSize="12sp"
            tools:text="观看到 12:30" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxWidth="64dp"
            android:singleLine="true"
            android:textColor="@color/white_60"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="泥巴"
            tools:visibility="visible" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
