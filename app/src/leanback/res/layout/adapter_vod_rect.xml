<?xml version="1.0" encoding="utf-8"?>
<!--
  网格矩形海报卡片（首页 / 分类 / 搜索结果，VodRectHolder）。

  JetStream 风格三段式垂直卡片：
    ① poster 容器（图片，16dp 四角圆角，聚焦描边只套这一层）
    ② name 片名（海报下方独立一行，26dp，左对齐，未聚焦浅灰 / 聚焦纯白）
    ③ metadata 元数据行（年份 · 备注 · 站源，12sp，聚焦时展开）

  与旧版的区别：片名不再用深色条压在海报底部、图片不再只圆上方两角；
  角标也不再贴在图片上，统一收进海报下方的元数据行，视觉更干净。
  尺寸由 VodRectHolder.size() 运行时写入 poster.height / root.width。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- duplicateParentState：焦点在卡片根上，让描边能跟随 state_focused。 -->
    <FrameLayout
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:clipChildren="false"
        android:duplicateParentState="true"
        android:foreground="@drawable/selector_vod">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_20"
            app:shapeAppearanceOverlay="@style/Vod.Grid" />

        <!--
          评分角标：仅当片名备注是「评分：x.x」（TMDB 刮削写入）时显示，
          首页 / 站源数据没有这种备注，常态 GONE，不影响原有外观。
        -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/shape_vod_score"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="8.7"
            tools:visibility="visible" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="8dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/selector_vod_title"
        android:textSize="16sp"
        tools:text="蜘蛛人" />

    <!--
      悬停展开：VodRectHolder 在聚焦时置 VISIBLE，失焦回到 INVISIBLE（保留占位，卡片不跳动）。

      <b>基线对齐（勿改成 center_vertical）</b>：横排 LinearLayout 只在子项「非
      match_parent 高度 + 垂直 gravity 为 TOP」时才做基线对齐（CENTER_VERTICAL 分支
      里基线对齐被官方移除，见 bug #1038483）。早期这里给行和子项都写了
      center_vertical，各文字按自身字体度量独立居中：纯数字（Roboto）与中文
      （回退的 Noto CJK，ascent/descent 更大）算出的基线不同，实测「2026」会比
      「更新至HD」高约 4px。现在子项高度改 wrap_content、行垂直 gravity 取 top，
      由 LinearLayout 统一把各行文本的基线拉到同一条线上。
    -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/metadata"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:gravity="start|top"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:visibility="invisible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/white_60"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="2022"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/white_60"
            android:textSize="12sp"
            tools:text="更新至第 12 集" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxWidth="64dp"
            android:singleLine="true"
            android:textColor="@color/white_60"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="泥巴"
            tools:visibility="visible" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
